# Copier en .env. Valeurs FACTICES uniquement.
# Les vrais secrets vivent dans /etc/app-secrets/iam/ et sont injectes
# via Docker Compose Secrets (/run/secrets/...), jamais ici.
APP_NAME=iam
WORKER_INTERVAL=30
# Dernier jour de collecte du pilote (AAAA-MM-JJ). Vide : collecte fermee.
# Les passations sont supprimees 3 ans apres cette date (worker).
COLLECTE_FIN=
